// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  favorites Favorite[]
  chatSessions ChatSession[]
}

enum Role {
  USER
  ADMIN
}

model Car {
  id           String   @id @default(cuid())
  make         String
  model        String
  year         Int
  price        Float
  mileage      Int
  condition    Condition
  bodyType     BodyType
  fuel         FuelType
  transmission Transmission
  color        String
  engine       String
  horsepower   Int?
  description  String
  images       String[]
  featured     Boolean  @default(false)
  status       CarStatus @default(AVAILABLE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders    Order[]
  favorites Favorite[]

  @@index([make, model])
  @@index([price])
  @@index([status])
}

enum Condition {
  NEW
  USED
  CERTIFIED
}

enum BodyType {
  SEDAN
  SUV
  TRUCK
  COUPE
  HATCHBACK
  CONVERTIBLE
  VAN
  WAGON
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum CarStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  carId     String
  type      OrderType
  status    OrderStatus @default(PENDING)
  amount    Float
  stripeId  String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])
  car  Car  @relation(fields: [carId], references: [id])
}

enum OrderType {
  INQUIRY
  DEPOSIT
  PURCHASE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  carId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  car  Car  @relation(fields: [carId], references: [id])

  @@unique([userId, carId])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])
}

enum MessageRole {
  USER
  ASSISTANT
}
