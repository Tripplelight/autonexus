// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  role      Role     @default(USER)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  favorites    Favorite[]
  chatSessions ChatSession[]
  dealer       Dealer?
}

enum Role {
  USER
  DEALER
  SUPER_ADMIN
}

// ── Dealers ───────────────────────────────────────────────────────────────────
model Dealer {
  id                String           @id @default(cuid())
  userId            String           @unique
  businessName      String
  phone             String
  location          String
  kraPin            String?
  logo              String?
  description       String?
  whatsapp          String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime
  subscriptionEndsAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  cars         Car[]
  orders       Order[]
  subscriptions Subscription[]

  @@index([subscriptionStatus])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

// ── Subscriptions ─────────────────────────────────────────────────────────────
model Subscription {
  id        String             @id @default(cuid())
  dealerId  String
  amount    Float
  status    SubscriptionPaymentStatus @default(PENDING)
  mpesaRef  String?
  period    String             // e.g. "2024-01"
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  dealer Dealer @relation(fields: [dealerId], references: [id])
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
}

// ── Cars ──────────────────────────────────────────────────────────────────────
model Car {
  id           String       @id @default(cuid())
  dealerId     String?
  make         String
  model        String
  year         Int
  price        Float
  mileage      Int
  condition    Condition
  bodyType     BodyType
  fuel         FuelType
  transmission Transmission
  color        String
  engine       String
  horsepower   Int?
  description  String
  images       String[]
  featured     Boolean      @default(false)
  status       CarStatus    @default(AVAILABLE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  dealer    Dealer?   @relation(fields: [dealerId], references: [id])
  orders    Order[]
  favorites Favorite[]

  @@index([make, model])
  @@index([price])
  @@index([status])
  @@index([dealerId])
}

enum Condition {
  NEW
  USED
  CERTIFIED
}

enum BodyType {
  SEDAN
  SUV
  TRUCK
  COUPE
  HATCHBACK
  CONVERTIBLE
  VAN
  WAGON
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum CarStatus {
  AVAILABLE
  RESERVED
  SOLD
}

// ── Orders ────────────────────────────────────────────────────────────────────
model Order {
  id        String      @id @default(cuid())
  userId    String
  carId     String
  dealerId  String?
  type      OrderType
  status    OrderStatus @default(PENDING)
  amount    Float
  stripeId  String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  car    Car     @relation(fields: [carId], references: [id])
  dealer Dealer? @relation(fields: [dealerId], references: [id])
}

enum OrderType {
  INQUIRY
  DEPOSIT
  PURCHASE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ── Favorites ─────────────────────────────────────────────────────────────────
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  carId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  car  Car  @relation(fields: [carId], references: [id])

  @@unique([userId, carId])
}

// ── Chat ──────────────────────────────────────────────────────────────────────
model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])
}

enum MessageRole {
  USER
  ASSISTANT
}